# Server-side only. Never expose these through NEXT_PUBLIC_* variables.
# Stable Modal HTTPS endpoint for the Pegas lifecycle PoC.
MODEL_BASE_URL=https://<workspace>--pegas-modal-lifecycle-poc-web.modal.run

# Modal proxy auth token. Placeholder only; use the complete wk-....ws-.... value in deployment secrets.
MODEL_AUTH_TOKEN=wk-...ws-...

# Model served by the Modal-hosted Ollama runtime.
OLLAMA_MODEL=qwen3:4b

# Compute label displayed by the existing Pegas UI.
GPU_LABEL=NVIDIA L4

# Agentic Payments / x402 on Solana Devnet. OFF by default.
AGENTIC_PAYMENTS_ENABLED=false
X402_FACILITATOR_URL=https://x402.org/facilitator
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/<API_KEY>
PAYMENT_BUYER_PRIVATE_KEY=<server-only-placeholder>
PAYMENT_BUYER_ADDRESS=<public-key-placeholder>
LEGAL_PAY_TO=<public-key-placeholder>
LEGAL_SERVICE_BASE_URL=https://<deployment-host>
LEGAL_SERVICE_AUTH_SECRET=<server-only-placeholder>
LEGAL_CONSULTATION_AMOUNT_ATOMIC=10000
PAYMENT_MAX_PER_OPERATION_ATOMIC=10000
PAYMENT_MAX_DAILY_ATOMIC=100000
PAYMENT_MAX_PER_SESSION_ATOMIC=30000
UPSTASH_REDIS_REST_URL=<placeholder>
UPSTASH_REDIS_REST_TOKEN=<placeholder>

# Live smoke remains impossible unless explicitly opted in.
LIVE_X402_SMOKE_CONFIRM=
