# Server-side only. Never expose these through NEXT_PUBLIC_* variables.
MODEL_BASE_URL=

# Reserved for a future real endpoint-auth contract. Do not assume Bearer auth.
MODEL_AUTH_TOKEN=

# Verified target tag from the proof run. Confirm again when a new Pod is deployed.
OLLAMA_MODEL=qwen3:4b

# Set to the actual GPU used by the current model Pod, for example after verifying it in RunPod/nvidia-smi.
GPU_LABEL=
