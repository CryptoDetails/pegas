# Server-side only. Never expose these through NEXT_PUBLIC_* variables.
# Stable Modal HTTPS endpoint for the Pegas lifecycle PoC.
MODEL_BASE_URL=https://<workspace>--pegas-modal-lifecycle-poc-web.modal.run

# Modal proxy auth token. Placeholder only; use the complete wk-....ws-.... value in deployment secrets.
MODEL_AUTH_TOKEN=wk-...ws-...

# Model served by the Modal-hosted Ollama runtime.
OLLAMA_MODEL=qwen3:4b

# Compute label displayed by the existing Pegas UI.
GPU_LABEL=NVIDIA L4
